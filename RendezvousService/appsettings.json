{

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "Rendezvous": {

    "ControlAddress":         "127.0.0.1",
    "ControlPort":            8500,

    "DataAddress":            "0.0.0.0",
    "MinDataPort":            1024,
    "MaxDataPort":            65535,

    "RendezvousTimeout":      "00:05:00",
    "IdleTimeout":            "00:10:00",
    "MaintenanceInterval":    "00:00:15",
    "AutoMaintenance":        true,
    "ControlIdleTimeout":     "00:02:00",

    "MaxSessions":            256,
    "MaxPortsPerSession":     16,
    "MaxControlConnections":  64,
    "MaxCommandLength":       4096,

    "DefaultProfile":         "Balanced",

    "Profiles": {

      "Balanced": {
        "NoDelay":                  true,
        "RelayBufferSize":          65536,
        "SocketReceiveBufferSize":  null,
        "SocketSendBufferSize":     null,
        "TcpKeepAlive":             true,
        "KeepAliveTime":            "00:01:00",
        "KeepAliveInterval":        "00:00:15",
        "KeepAliveRetryCount":      5,
        "BroadcastQueueLength":     128,
        "BroadcastQueueBytes":      4194304,
        "ListenBacklog":            8
      },

      "Interactive": {
        "NoDelay":                  true,
        "RelayBufferSize":          8192,
        "SocketReceiveBufferSize":  32768,
        "SocketSendBufferSize":     32768,
        "TcpKeepAlive":             true,
        "KeepAliveTime":            "00:00:30",
        "KeepAliveInterval":        "00:00:10",
        "KeepAliveRetryCount":      3,
        "BroadcastQueueLength":     512,
        "BroadcastQueueBytes":      1048576,
        "ListenBacklog":            8
      },

      "Bulk": {
        "NoDelay":                  false,
        "RelayBufferSize":          262144,
        "SocketReceiveBufferSize":  null,
        "SocketSendBufferSize":     null,
        "TcpKeepAlive":             true,
        "KeepAliveTime":            "00:02:00",
        "KeepAliveInterval":        "00:00:30",
        "KeepAliveRetryCount":      5,
        "BroadcastQueueLength":     32,
        "BroadcastQueueBytes":      16777216,
        "ListenBacklog":            8
      }

    }

  }

}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.RendezvousService.Tests</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.RendezvousService.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- The very file the service ships with, so that a test can prove it
         still binds and validates. -->
    <None Include="..\RendezvousService\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- The rendezvous library itself is tested within HermodTests, this project
         only covers what the application adds: the hosted service and the
         IValidateOptions adapter. -->
    <ProjectReference Include="..\RendezvousService\RendezvousService.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Rendezvous</RootNamespace>
    <AssemblyName>org.GraphDefined.Vanaheimr.Rendezvous</AssemblyName>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only dependency of the library: everything else it needs is within
         the shared framework. No hosting, no options, no configuration binder. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach into the relay internals (chunk pooling, socket pumps)
         and into the janitor, which are deliberately not part of the public surface. -->
    <InternalsVisibleTo Include="org.GraphDefined.Vanaheimr.Rendezvous.Tests" />
  </ItemGroup>

</Project>
